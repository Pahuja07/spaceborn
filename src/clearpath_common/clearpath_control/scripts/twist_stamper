#!/usr/bin/env python3
"""twist_stamper — relay: geometry_msgs/Twist -> geometry_msgs/TwistStamped
Bridges twist_mux (Twist output) to diff_drive_controller (TwistStamped input).
Stamps with the node's own clock so sim-time is respected under use_sim_time:=true."""

import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist, TwistStamped


class TwistStamper(Node):
    def __init__(self):
        super().__init__('twist_stamper')
        self.pub = self.create_publisher(TwistStamped, 'cmd_vel_out', 10)
        self.sub = self.create_subscription(Twist, 'cmd_vel_in', self.cb, 10)

    def cb(self, msg: Twist):
        out = TwistStamped()
        out.header.stamp = self.get_clock().now().to_msg()
        out.header.frame_id = 'base_link'
        out.twist = msg
        self.pub.publish(out)


def main(args=None):
    rclpy.init(args=args)
    node = TwistStamper()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()


if __name__ == '__main__':
    main()
